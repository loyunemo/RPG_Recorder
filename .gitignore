# 依赖与构建产物
node_modules/
# 打包输出（安装包 70+ MB，走 GitHub Releases 分发，不进仓库）
release/
# 打包中间产物；build/icon.png 是源文件，要提交，所以只忽略其中生成物
build/*.ico
build/*.icns

# 包管理器 / Electron 二进制缓存（体积大，可随时重新下载）
.npm-cache/
.electron-cache/

# 跑团数据：默认写在这里，包含战役、角色卡与日志
# 必须锚定到仓库根目录，否则会连带忽略 src/core/rulesets/huazhu/data/ 里的规则数据
/data/
*.tmp

# 开发与测试时用到的临时目录（一律不提交）
.shots/
.smoke/
.demo/
.demo2/
.verify/
.verify2/
.mp-test/
.pshots/
.docx-tmp/
.tmp/
*.log

# 第三方原始资料：华渚框架原书著作权归作者【虚拟人】所有。
# 本项目只提交从中提炼的派生规则数据（src/core/rulesets/huazhu/data/），
# 不重新分发原书本身。若你有权公开它，删掉下面这行即可。
《华渚》*.docx

# 编辑器
.vscode/
.idea/
.DS_Store
Thumbs.db
.git-commit-msg.txt
